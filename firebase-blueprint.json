{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile details for authenticated VERFIED users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication User ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "URL of user avatar or profile icon",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation",
          "maxLength": 50
        }
      },
      "required": ["uid", "name", "createdAt"]
    },
    "UserPrivateData": {
      "title": "UserPrivateData",
      "description": "Private contact details and profile metadata isolated to user owner",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase user identifier matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Verified email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Customer contact telephone number",
          "maxLength": 30
        },
        "role": {
          "type": "string",
          "description": "User access role in platform",
          "enum": ["customer", "admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp",
          "maxLength": 50
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product stored in Firebase and database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product SKU or identifier",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Product title",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Detailed product description",
          "maxLength": 3000
        },
        "price": {
          "type": "number",
          "description": "Selling price in GHS"
        },
        "originalPrice": {
          "type": "number",
          "description": "Strikethrough list price in GHS"
        },
        "category": {
          "type": "string",
          "description": "Product category",
          "maxLength": 60
        },
        "image": {
          "type": "string",
          "description": "Primary product image URL",
          "maxLength": 500
        },
        "rating": {
          "type": "number",
          "description": "Customer review rating"
        },
        "tag": {
          "type": "string",
          "description": "Promotional tag label",
          "maxLength": 60
        },
        "inStock": {
          "type": "boolean",
          "description": "Availability status"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of inventory record update",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order purchase record in VERFIED store",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order identifier",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "UID of purchaser or guest ID",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of customer",
          "maxLength": 150
        },
        "customerName": {
          "type": "string",
          "description": "Full shipping name",
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Contact telephone number",
          "maxLength": 30
        },
        "shippingAddress": {
          "type": "string",
          "description": "Delivery address destination",
          "maxLength": 500
        },
        "subtotal": {
          "type": "number",
          "description": "Order subtotal amount in GHS"
        },
        "total": {
          "type": "number",
          "description": "Order total charge in GHS"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected checkout method",
          "maxLength": 50
        },
        "paymentReference": {
          "type": "string",
          "description": "Unique transaction confirmation identifier",
          "maxLength": 100
        },
        "paymentPhone": {
          "type": "string",
          "description": "MoMo or contact phone used for transaction",
          "maxLength": 30
        },
        "paymentApiKey": {
          "type": "string",
          "description": "Payment API key used for verification",
          "maxLength": 100
        },
        "gatewayAuth": {
          "type": "string",
          "description": "Gateway authorization reference code",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Fulfillment status of order",
          "enum": ["pending", "verified", "processing", "shipped", "delivered", "cancelled"],
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the order was submitted",
          "maxLength": 50
        }
      },
      "required": ["id", "customerName", "total", "status", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Inquiry or concierge assistance ticket",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ticket identifier",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "Optional authenticated submitter UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Sender full name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "description": "Reply-to email address",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Topic of inquiry",
          "maxLength": 50
        },
        "subject": {
          "type": "string",
          "description": "Brief description",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Detailed question or issue statement",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "description": "Status of support ticket",
          "enum": ["open", "in_progress", "resolved", "closed"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "category", "message", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Real-time audit log of purchases and admin operations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit log identifier",
          "maxLength": 64
        },
        "actionType": {
          "type": "string",
          "description": "Categorized action key",
          "maxLength": 60
        },
        "actor": {
          "type": "string",
          "description": "Person or system that triggered action",
          "maxLength": 150
        },
        "details": {
          "type": "string",
          "description": "Summary and contextual details",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of action",
          "maxLength": 50
        }
      },
      "required": ["id", "actionType", "actor", "createdAt"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Health check document for testing Firestore server connectivity",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Status of test connection",
          "maxLength": 50
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of smoke test",
          "maxLength": 50
        }
      },
      "required": ["status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review and rating stored in database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique review identifier",
          "maxLength": 64
        },
        "productId": {
          "type": "string",
          "description": "ID of product reviewed",
          "maxLength": 64
        },
        "userName": {
          "type": "string",
          "description": "Name of reviewer",
          "maxLength": 100
        },
        "userEmail": {
          "type": "string",
          "description": "Reviewer email address",
          "maxLength": 150
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "Review comments and feedback text",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "productId", "userName", "rating", "comment", "createdAt"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "Customer wishlist or saved product selection stored in database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique saved item record ID",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "Customer user identifier or session key",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "Referenced product SKU or identifier",
          "maxLength": 64
        },
        "productName": {
          "type": "string",
          "description": "Name of saved product",
          "maxLength": 150
        },
        "price": {
          "type": "number",
          "description": "Product price in GHS"
        },
        "category": {
          "type": "string",
          "description": "Category of product",
          "maxLength": 60
        },
        "image": {
          "type": "string",
          "description": "Product display thumbnail URL",
          "maxLength": 500
        },
        "itemType": {
          "type": "string",
          "description": "Type of saved record: wishlist or cart",
          "maxLength": 30
        },
        "quantity": {
          "type": "number",
          "description": "Quantity saved"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of save action",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "productId", "productName", "price", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": "UserProfile",
      "description": "Public profile document for a user"
    },
    "/users/{userId}/private/info": {
      "schema": "UserPrivateData",
      "description": "Private sensitive PII information accessible strictly to the user owner"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog product items collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support requests submitted to concierge desk"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Activity audit records for commerce and admin actions"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer product reviews and ratings collection"
    },
    "/saved_items/{itemId}": {
      "schema": "SavedItem",
      "description": "Customer saved items and wishlist collection"
    },
    "/test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Smoke test collection for verifying server database connection"
    }
  }
}
